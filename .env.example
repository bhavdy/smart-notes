# =============================================
# Smart Notes Management System — .env.example
# =============================================

# --- Database ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smart_notes
MYSQL_USER=notes_user
MYSQL_PASSWORD=notes_pass

# --- Backend ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_notes
SPRING_DATASOURCE_USERNAME=notes_user
SPRING_DATASOURCE_PASSWORD=notes_pass
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=SmartNotes
